{
  "name": "list-to-do-server",
  "version": "1.0.0",
  "description": "API da to-do list com autenticação JWT",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "node scripts/studio.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "argon2@0.45.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "private": true
}
